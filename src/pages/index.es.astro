---
import { getImage } from "astro:assets";
import LandingLayout from "../layouts/LandingLayout.astro";
import Shot from "../components/Shot.astro";
import StoreBadge from "../components/StoreBadge.astro";
import { PRICE_LABEL, PRICE_USD } from "../config/site";
import demoPoster from "../assets/img/demo-poster.webp";
import drilldownEs from "../assets/img/drilldown-es.webp";
import reportEs from "../assets/img/report-es.webp";
import panelEs from "../assets/img/panel-es.webp";
import notificationsEs from "../assets/img/notifications-es.webp";
import aiEs from "../assets/img/ai-es.webp";

// The poster is the LCP element; one WebP sized for a 2x hero is enough.
const poster = await getImage({ src: demoPoster, format: "webp", width: 1564 });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Internet Monitor: Uptime",
  "operatingSystem": "macOS 14.0 or later",
  "applicationCategory": "UtilitiesApplication",
  "description": "Una app nativa para la barra de menus de macOS que detecta cortes de hasta un segundo, separa la evidencia por red y genera un reporte PDF para tu proveedor.",
  "inLanguage": "es",
  "offers": {
    "@type": "Offer",
    "price": PRICE_USD,
    "priceCurrency": "USD"
  },
  "url": "https://internetmonitor.app/index.es.html",
  "downloadUrl": "https://apps.apple.com/app/id6818842901",
  "author": {
    "@type": "Person",
    "name": "Andres Carreno",
    "url": "https://andrescarreno.co"
  }
};

const page = {
  "lang": "es" as const,
  "title": "Internet Monitor: Uptime para Mac, el monitor de internet que te da pruebas",
  "description": "Una app nativa para la barra de menús de tu Mac que detecta cortes de hasta un segundo, separa la evidencia por red y genera un reporte PDF para tu proveedor. Tu IA también puede consultarla (MCP).",
  "path": "/index.es.html",
  "alternates": {
    "en": "/",
    "es": "/index.es.html"
  },
  "ogTitle": "Internet Monitor: Uptime para Mac",
  "ogDescription": "El monitor de internet que te da pruebas. Cortes de hasta un segundo, evidencia por red y un reporte PDF para tu proveedor."
};
---
<LandingLayout {...page} jsonLd={jsonLd} preloadImage={poster.src}>
<header class="hero">
  <div class="container">
    <div class="nav">
      <a class="brand" href="/index.es.html"><span class="ring-mini" aria-hidden="true"></span><span>Internet Monitor<span class="brand-sub">: Uptime</span></span></a>
      <nav>
        <a href="#features" class="hide-sm">Funciones</a>
        <a href="#mcp">IA&nbsp;+&nbsp;MCP</a>
        <a href="/support.es.html">Soporte</a>
        <a href="/" lang="en" hreflang="en">English</a>
      </nav>
    </div>

    <div class="hero-inner">
      <div class="ring-wrap" aria-hidden="true">
        <div class="ring"></div>
        <span class="pct">99.8%</span>
      </div>
      <h1>El monitor de internet que te da <em>pruebas</em></h1>
      <p class="sub">Una app nativa para la barra de menús de tu Mac que detecta cortes de hasta un segundo, separa la evidencia por red y la convierte en un reporte PDF que tu proveedor no puede discutir.</p>
      <StoreBadge lang="es" />
      <p class="fineprint">{PRICE_LABEL}, compra única &middot; macOS 14 o superior &middot; Privacidad: no se recopilan datos</p>
      <figure class="shot hero-shot">
        <video src="/assets/video/demo.mp4" poster={poster.src} controls preload="none" playsinline muted width="1564" height="1080" aria-label="Demo de 30 segundos: Internet Monitor detecta un corte, avisa cuando empieza y termina, y lo muestra en el dashboard con la hora exacta"></video>
      </figure>
    </div>
  </div>
</header>

<main>
  <div class="container">

    <section class="strip" aria-label="Cifras clave">
      <div class="reveal"><div class="num green">1 segundo</div><div class="label">cortes así de breves se detectan y confirman</div></div>
      <div class="reveal"><div class="num blue">365 días</div><div class="label">de historial, guardado como archivos simples en tu Mac</div></div>
      <div class="reveal"><div class="num purple">0 bytes</div><div class="label">de tus datos recopilados, jamás</div></div>
    </section>

    <section id="features">

      <article class="feature reveal">
        <div class="copy">
          <span class="eyebrow"><span class="badge-ic red" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13 2 L5 14 h6 l-1 8 L19 10 h-6 z"/></svg></span>Cortes de hasta un segundo</span>
          <h2>Atrapa los cortes que tu proveedor jura que no existieron</h2>
          <p>Internet Monitor revisa tu conexión cada dos segundos, o cada uno si quieres. Cada chequeo fallido se <strong>confirma con un reintento inmediato</strong>, así que hasta un corte de un segundo queda en tu historial como un hecho, no una sensación.</p>
          <p>Expande cualquier corte y ve exactamente qué falló: cada objetivo de sondeo, cada muestra de latencia y si el DNS seguía respondiendo.</p>
        </div>
        <Shot src={drilldownEs} alt="Detalle de un corte con los resultados por sonda alrededor de un corte confirmado de un segundo" />
      </article>

      <article class="feature flip reveal">
        <div class="copy">
          <span class="eyebrow"><span class="badge-ic blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3 h10 a2 2 0 0 1 2 2 v14 a2 2 0 0 1 -2 2 H7 a2 2 0 0 1 -2 -2 V5 a2 2 0 0 1 2 -2 z M9 8 h6 M9 12 h6 M9 16 h4"/></svg></span>Reporte PDF para tu ISP</span>
          <h2>Evidencia que puedes enviarle a tu proveedor</h2>
          <p>Decir "se siente inestable" no sirve de nada con soporte. Elige un período y una red y obtén un PDF impecable: <strong>cada corte con su hora exacta</strong>, uptime y latencia por día, listo para adjuntar a tu reclamo.</p>
          <p>Deja que los datos discutan por ti.</p>
        </div>
        <Shot src={reportEs} alt="Reporte PDF de conexión generado por la app, abierto en Vista Previa, con resumen y gráficas" class="light" />
      </article>

      <article class="feature reveal">
        <div class="copy">
          <span class="eyebrow"><span class="badge-ic green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 9 a14 14 0 0 1 20 0 M5.5 13 a9 9 0 0 1 13 0 M9 16.8 a4.5 4.5 0 0 1 6 0 M12 20.2 h0.01"/></svg></span>Evidencia por red</span>
          <h2>Evidencia que culpa a la red correcta</h2>
          <p>Cada chequeo queda <strong>etiquetado con la red donde corrió</strong>. Wi-Fi de casa, oficina, hotspot: cada una mantiene su propio uptime, sus cortes y su reporte, para que tu reclamo solo culpe al proveedor que lo merece. Ningún otro monitor hace esto.</p>
          <p>El panel de la barra de menús tiene lo esencial a un clic: latencia en vivo, estado del DNS, IP local y pública, ancho de banda y datos usados.</p>
        </div>
        <Shot src={panelEs} alt="Panel de la barra de menús con el estado de la conexión, ancho de banda, IPs y el nombre de la red actual" cap={420} capStyle />
      </article>

      <article class="feature flip reveal">
        <div class="copy">
          <span class="eyebrow"><span class="badge-ic yellow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 a6 6 0 0 0 -6 6 v4 l-2 3 h16 l-2 -3 V9 a6 6 0 0 0 -6 -6 z M10 19 a2 2 0 0 0 4 0"/></svg></span>Notificaciones inteligentes</span>
          <h2>Entérate en el momento en que se cae, y cuando vuelve</h2>
          <p>Notificaciones nativas cuando la conexión se cae y cuando regresa, <strong>con la duración del corte</strong>. Define tu umbral y tu sonido, y los cortes repetidos se agrupan en un solo aviso de "conexión inestable" en vez de una tormenta.</p>
        </div>
        <Shot src={notificationsEs} alt="Notificaciones de macOS: internet caído, e internet de vuelta tras 1.0s" />
      </article>

    </section>

    <section id="mcp" class="mcp reveal">
      <div class="mcp-inner">
        <div class="copy">
          <span class="pill">Solo aquí: servidor MCP incluido</span>
          <h2>Pregúntale a tu IA por tu internet</h2>
          <p class="q">"¿Cómo estuvo mi internet esta semana?"</p>
          <p>Un servidor MCP incluido permite que <strong>Claude, ChatGPT o cualquier cliente MCP</strong> responda con tus propios datos locales: uptime, cortes, latencia, por red. Instalación de un clic para Claude y una configuración corta para el resto.</p>
          <p>Tus mediciones nunca salen de tu Mac; tu IA viene a ellas. Ningún otro monitor de internet tiene esto.</p>
          <p><a class="link" href="/ai.es.html">Configúralo en un clic &rarr;</a></p>
        </div>
        <Shot src={aiEs} alt="Pantalla de bienvenida: pregúntale a tu IA por tu internet, con un botón para instalar la extensión de Claude" cap={420} />
      </div>
    </section>

    <section class="privacy reveal">
      <div class="seal"><span aria-hidden="true">&#10003;</span> Privacidad: no se recopilan datos</div>
      <h2>Privada por diseño</h2>
      <p>Sin cuenta, sin analítica, sin rastreo. Todo lo que la app mide se queda en tu Mac como archivos simples que puedes exportar cuando quieras. La app solo usa internet para medirlo.</p>
      <p><a href="/privacy.es.html">Lee la política de privacidad</a></p>
    </section>

    <section class="grid" aria-label="Más funciones">
      <div class="cardlet reveal">
        <div class="head"><span class="badge-ic blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 13 L17 8 M4 15 a8 8 0 0 1 16 0 M7.5 15 a4.5 4.5 0 0 1 9 0"/></svg></span><h3>Ancho de banda en vivo</h3></div>
        <p>Velocidad de subida y bajada actual más el uso acumulado de datos, leído localmente de los contadores de red.</p>
      </div>
      <div class="cardlet reveal">
        <div class="head"><span class="badge-ic green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 7 v5 l3 3 M21 12 a9 9 0 1 1 -9 -9 a9 9 0 0 1 9 9 z"/></svg></span><h3>Tu propio ritmo</h3></div>
        <p>Chequeos cada 1 a 10 segundos, ajustables desde el dashboard. Cada chequeo pesa unos cientos de bytes.</p>
      </div>
      <div class="cardlet reveal">
        <div class="head"><span class="badge-ic yellow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 12 l2 2 l4 -5 M12 3 l7 3 v6 c0 4 -3 7 -7 9 c-4 -2 -7 -5 -7 -9 V6 z"/></svg></span><h3>Mediciones honestas</h3></div>
        <p>Wi-Fi apagado o cable suelto nunca se registra como corte del ISP, y las estadísticas pesan por tiempo, no por muestras.</p>
      </div>
      <div class="cardlet reveal">
        <div class="head"><span class="badge-ic purple" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4 c-2 0 -3 1 -3 3 v2 c0 1.5 -1 2 -2 3 c1 1 2 1.5 2 3 v2 c0 2 1 3 3 3 M16 4 c2 0 3 1 3 3 v2 c0 1.5 1 2 2 3 c-1 1 -2 1.5 -2 3 v2 c0 2 -1 3 -3 3"/></svg></span><h3>Export de datos crudos</h3></div>
        <p>Exporta cada chequeo y cada corte en JSON o CSV, para tu propio análisis o tus scripts.</p>
      </div>
      <div class="cardlet reveal">
        <div class="head"><span class="badge-ic red" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 12 m-2 0 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0 M12 12 m-6 0 a6 6 0 1 0 12 0 a6 6 0 1 0 -12 0 M12 2 v4 M12 18 v4 M2 12 h4 M18 12 h4"/></svg></span><h3>Objetivos configurables</h3></div>
        <p>Apunta los chequeos a tu propio servidor o router, con puerto configurable.</p>
      </div>
      <div class="cardlet reveal">
        <div class="head"><span class="badge-ic green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 c4 3 6 7 6 11 a6 6 0 0 1 -12 0 c0 -4 2 -8 6 -11 z M12 21 v-6"/></svg></span><h3>Nativa y ligera</h3></div>
        <p>Hecha en Swift y SwiftUI. Cerca de 0.5% de CPU mientras monitorea, con inicio al arrancar opcional.</p>
      </div>
    </section>

    <section class="cta reveal">
      <h2>Deja de discutir con tu proveedor. Empieza a probar.</h2>
      <p>Una sola compra, todas las funciones incluidas. Sin suscripción.</p>
      <StoreBadge lang="es" />
      <p class="fineprint">{PRICE_LABEL} &middot; macOS 14 o superior</p>
    </section>

  </div>
</main>
</LandingLayout>
