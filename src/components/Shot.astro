---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Extra classes on the figure, e.g. "light". */
  class?: string;
  /** Largest rendered width in CSS px; feature columns top out near 560. */
  cap?: number;
  /** Also enforce the cap on the image itself (the panel shot). */
  capStyle?: boolean;
}

const { src, alt, class: extra = "", cap = 560, capStyle = false } = Astro.props;

const sizes = `(max-width: 860px) min(calc(100vw - 48px), ${cap}px), ${cap}px`;
const widths = [480, 800, 1120, 1600].filter((w) => w < src.width).concat(src.width);
const style = capStyle ? `max-width: ${cap}px; margin: 0 auto;` : undefined;
---
<figure class:list={["shot", extra]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    loading="lazy"
    decoding="async"
    style={style}
  />
</figure>
